# BOOKFLO Stripe — TEST mode only (pk_test_ / sk_test_). Never commit real values.
# Platform account = Luke’s BOOKFLO Stripe (not Toni/Tee’s).

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Public origin for Checkout success/cancel + Connect return URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: pin OMS Express Connect account id after onboarding starts
# (otherwise stored in .data/stripe-connect.json for local/dev)
STRIPE_CONNECT_OMS_ACCOUNT_ID=

# Optional later: Stripe webhook signing secret (Billing + Connect)
# STRIPE_WEBHOOK_SECRET=whsec_xxx
