# BOOKFLO Stripe — platform account = Luke’s BOOKFLO (not Toni/Tee’s).
# Never commit real values. Agents: store secrets under /cursor/stores/self/internal/.

# test | live — must match key prefixes (no mixed modes)
STRIPE_MODE=test

# TEST: pk_test_ / sk_test_   LIVE: pk_live_ / sk_live_ (only after Luke supplies both)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Public origin for Checkout success/cancel + Connect return URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When UI stays on static deed and APIs run on a Node host, set the API origin:
# NEXT_PUBLIC_STRIPE_API_BASE=https://your-node-host.vercel.app

# Optional: show OMS £1 live smoke service (pay-in-full £1 / 50% deposit 50p)
# NEXT_PUBLIC_OMS_LIVE_SMOKE=1
# NEXT_PUBLIC_STRIPE_MODE=live

# Optional: pin OMS Express Connect account id after onboarding starts
# STRIPE_CONNECT_OMS_ACCOUNT_ID=acct_xxx

# Optional: extra CORS origins for the Node Stripe API (comma-separated)
# STRIPE_API_CORS_ORIGINS=https://preview.example

# Optional later: Stripe webhook signing secret (Billing + Connect)
# STRIPE_WEBHOOK_SECRET=whsec_xxx
